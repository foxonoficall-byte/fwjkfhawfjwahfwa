<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <title>ASCII Angel Animation</title>
  <hta:application
    id="asciiAnimation"
    applicationname="ASCII Angel Animation"
    border="thick"
    caption="yes"
    maximizebutton="yes"
    minimizebutton="yes"
    showintaskbar="yes"
    singleinstance="yes"
    sysmenu="yes"
    scroll="no"
    navigable="no"
  />
  <style>
    * { box-sizing: border-box; }
    html, body {
      width: 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
      background: #050914;
    }
    canvas {
      width: 100%;
      height: calc(100% - 72px);
      display: block;
    }
    #caption {
      height: 72px;
      line-height: 72px;
      text-align: center;
      color: #d7eaff;
      font: 24px Georgia, serif;
      letter-spacing: 5px;
      opacity: 0;
    }
  </style>
</head>
<body>
<canvas id="screen"></canvas>
<div id="caption">waiting</div>
<script type="text/javascript">
  var canvas = document.getElementById("screen");
  var ctx = canvas.getContext("2d");
  var caption = document.getElementById("caption");
  var image = new Image();
  image.src = "data:image/png;base64,";

  var shades = " .,:;irsXA253hMHGS#9B&@";
  var grid = [];
  var reveal = 0;
  var start = new Date().getTime();

  function resize() {
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.floor(canvas.clientWidth * dpr);
    canvas.height = Math.floor(canvas.clientHeight * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function makeGrid() {
    var viewWidth = canvas.clientWidth;
    var viewHeight = canvas.clientHeight;
    var cols = Math.max(160, Math.min(300, Math.floor(viewWidth / 5)));
    var rows = Math.floor(cols * viewHeight / viewWidth);
    var off = document.createElement("canvas");
    off.width = cols;
    off.height = rows;
    var offCtx = off.getContext("2d");

    var scale = Math.min(cols / image.width, rows / image.height) * 0.92;
    var w = image.width * scale;
    var h = image.height * scale;
    var left = (cols - w) / 2;
    var top = (rows - h) / 2;

    offCtx.fillStyle = "#050914";
    offCtx.fillRect(0, 0, cols, rows);
    offCtx.drawImage(image, left, top, w, h);
    var data = offCtx.getImageData(0, 0, cols, rows).data;

    grid = [];
    for (var y = 0; y < rows; y++) {
      grid[y] = [];
      for (var x = 0; x < cols; x++) {
        var i = (y * cols + x) * 4;
        var r = data[i];
        var g = data[i + 1];
        var b = data[i + 2];
        var lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;
        var value = Math.max(0, Math.min(1, (lum - 10) / 235));
        var index = Math.min(shades.length - 1, Math.floor(value * shades.length));
        grid[y][x] = value < 0.10 ? null : {
          ch: shades.charAt(index),
          r: Math.min(255, 45 + r * 0.82),
          g: Math.min(255, 95 + g * 0.72),
          b: Math.min(255, 205 + b * 0.35)
        };
      }
    }
  }

  function draw() {
    var now = new Date().getTime();
    var viewWidth = canvas.clientWidth;
    var viewHeight = canvas.clientHeight;
    ctx.fillStyle = "#050914";
    ctx.fillRect(0, 0, viewWidth, viewHeight);

    if (!grid.length) {
      window.requestAnimationFrame(draw);
      return;
    }

    var time = (now - start) / 1000;
    var intro = Math.max(0, Math.min(1, time / 2.35));
    if (intro < 1) {
      caption.style.opacity = intro;
    } else if (caption.style.opacity !== "1") {
      caption.style.opacity = "1";
    }
    reveal = intro >= 1 ? grid.length : Math.min(grid.length, 1 + intro * grid.length);
    var cellW = viewWidth / grid[0].length;
    var cellH = viewHeight / grid.length;
    var introScale = intro < 1 ? 0.35 + intro * 0.65 : 1;
    var fontSize = Math.max(4, Math.min(cellW * 1.35, cellH * 1.15) * introScale);
    ctx.font = fontSize + 'px "Courier New", monospace';
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    for (var y = 0; y < Math.floor(reveal); y++) {
      for (var x = 0; x < grid[y].length; x++) {
        var p = grid[y][x];
        if (!p) continue;

        if (intro < 1) {
          var dx = (x - grid[y].length * 0.5) / (grid[y].length * 0.5);
          var dy = (y - grid.length * 0.5) / (grid.length * 0.5);
          var distance = Math.sqrt(dx * dx + dy * dy);
          var radius = 0.04 + intro * 1.12;
          if (distance > radius) continue;
          ctx.globalAlpha = Math.max(0.12, 1 - (radius - distance) * 0.3);
        } else {
          ctx.globalAlpha = 1;
        }

        ctx.fillStyle = "rgb(" + (p.r | 0) + "," + (p.g | 0) + "," + (p.b | 0) + ")";
        ctx.fillText(p.ch, (x + 0.5) * cellW, (y + 0.5) * cellH);
      }
    }
    window.requestAnimationFrame(draw);
  }

  image.onload = function() {
    resize();
    makeGrid();
    reveal = 0;
    start = new Date().getTime();
    window.requestAnimationFrame(draw);
  };
  image.onerror = function() {
    alert("Could not load the image embedded in this application.");
  };
  window.onresize = function() {
    if (image.complete && image.width) {
      resize();
      makeGrid();
    }
  };
  window.onkeydown = function(event) {
    event = event || window.event;
    if (event.keyCode === 27) window.close();
  };
  window.onload = function() {
    window.resizeTo(1100, 760);
    window.moveTo(
      Math.max(0, (screen.availWidth - 1100) / 2),
      Math.max(0, (screen.availHeight - 760) / 2)
    );
  };
</script>
</body>
</html>
